{
  "name": "modesty-is-the-name",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser-based simultaneous-play word association party game",
  "scripts": {
    "dev": "concurrently --kill-others --names server,client \"tsx watch server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "npm run build && tsx server/index.ts",
    "tunnel": "cloudflared tunnel --url http://localhost:3000",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.21.2",
    "nanoid": "^5.0.9",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
